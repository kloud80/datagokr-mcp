{
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "{정책분야}/{부문}/{slug}",
      "title": "Id",
      "type": "string"
    },
    "sector": {
      "title": "Sector",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "이 공백 때문에 답할 수 없는 질문",
      "title": "Question"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "external_candidate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "포털 밖 대안 (시스템·사이트)",
      "title": "External Candidate"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "resolved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "해소한 세부 부문·데이터",
      "title": "Resolved By"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    }
  },
  "required": [
    "id",
    "sector",
    "name",
    "reason"
  ],
  "title": "Gap",
  "type": "object",
  "$id": "https://pds.local/schemas/gap.schema.json"
