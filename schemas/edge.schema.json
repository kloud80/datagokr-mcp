{
  "$defs": {
    "EdgeOn": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "items": {
            "type": "string"
          },
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "string"
          },
          "title": "Right",
          "type": "array"
        },
        "via_mapping": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Mapping"
        },
        "transform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "knowledge/rules/ 규칙 id 또는 설명",
          "title": "Transform"
        }
      },
      "title": "EdgeOn",
      "type": "object"
    },
    "EdgeVerified": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "measured",
            "documented",
            "admin"
          ],
          "title": "By",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "match_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Rate"
        },
        "at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        }
      },
      "required": [
        "by"
      ],
      "title": "EdgeVerified",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^e-\\d{4,}$",
      "title": "Id",
      "type": "string"
    },
    "src": {
      "title": "Src",
      "type": "string"
    },
    "dst": {
      "title": "Dst",
      "type": "string"
    },
    "rel": {
      "enum": [
        "joinable",
        "lookup",
        "instance_of",
        "supersedes",
        "same_concept",
        "continues",
        "related_to"
      ],
      "title": "Rel",
      "type": "string"
    },
    "on": {
      "anyOf": [
        {
          "$ref": "#/$defs/EdgeOn"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "relationship": {
      "anyOf": [
        {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relationship"
    },
    "direction": {
      "default": "src_to_dst",
      "enum": [
        "src_to_dst",
        "dst_to_src",
        "both"
      ],
      "title": "Direction",
      "type": "string"
    },
    "verified": {
      "anyOf": [
        {
          "$ref": "#/$defs/EdgeVerified"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "default": "auto",
      "enum": [
        "auto",
        "admin",
        "user"
      ],
      "title": "Source",
      "type": "string"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "id",
    "src",
    "dst",
    "rel"
  ],
  "title": "Edge",
  "type": "object",
  "$id": "https://pds.local/schemas/edge.schema.json"
}
