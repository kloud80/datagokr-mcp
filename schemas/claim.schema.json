{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "measured",
            "law",
            "portal_meta",
            "admin_review",
            "inferred",
            "user"
          ],
          "title": "Type",
          "type": "string"
        },
        "source": {
          "description": "근거 위치: 파일 경로#앵커, law:{id}#{조}, 포털 URL 등",
          "title": "Source",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "측정·관측일 (measured)",
          "title": "Observed At"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "결정·검토한 사람 (admin_review·user)",
          "title": "By"
        },
        "at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "결정·검토일",
          "title": "At"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "type",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "c-{dataset id}-{두 자리 이상 번호}",
      "pattern": "^c-[\\w:.-]+-\\d{2,}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "cadence",
        "publish_lag",
        "legal_basis",
        "key",
        "coverage",
        "health",
        "pitfall",
        "join_verified",
        "admin_note",
        "access"
      ],
      "title": "Kind",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "qualifiers": {
      "additionalProperties": true,
      "title": "Qualifiers",
      "type": "object"
    },
    "rank": {
      "default": "normal",
      "enum": [
        "preferred",
        "normal",
        "deprecated"
      ],
      "title": "Rank",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    }
  },
  "required": [
    "id",
    "kind",
    "value",
    "evidence"
  ],
  "title": "Claim",
  "type": "object",
  "$id": "https://pds.local/schemas/claim.schema.json"
}
