    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "c-{dataset id}-{두 자리 이상 번호}",
          "pattern": "^c-[\\w:.-]+-\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cadence",
            "publish_lag",
            "legal_basis",
            "key",
            "coverage",
            "health",
            "pitfall",
            "join_verified",
            "admin_note",
            "access"
