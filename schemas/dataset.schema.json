        "value": {
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "qualifiers": {
          "additionalProperties": true,
          "title": "Qualifiers",
          "type": "object"
        },
        "rank": {
          "default": "normal",
          "enum": [
            "preferred",
            "normal",
            "deprecated"
          ],
          "title": "Rank",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "id",
        "kind",
        "value",
        "evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
