{
  "$defs": {
    "MappingSide": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "system": {
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "key",
        "system"
      ],
      "title": "MappingSide",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9_]+__[a-z0-9_]+$",
      "title": "Id",
      "type": "string"
    },
    "left": {
      "$ref": "#/$defs/MappingSide"
    },
    "right": {
      "$ref": "#/$defs/MappingSide"
    },
    "method": {
      "enum": [
        "exact",
        "name_address_match",
        "coord_nearest",
        "manual",
        "composite"
      ],
      "title": "Method",
      "type": "string"
    },
    "built_at": {
      "format": "date",
      "title": "Built At",
      "type": "string"
    },
    "rows": {
      "minimum": 0,
      "title": "Rows",
      "type": "integer"
    },
    "match_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Match Rate",
      "type": "number"
    },
    "unmatched_policy": {
      "enum": [
        "keep_left",
        "keep_right",
        "keep_both",
        "drop"
      ],
      "title": "Unmatched Policy",
      "type": "string"
    },
    "file": {
      "title": "File",
      "type": "string"
    },
    "sources": {
      "description": "매핑을 만든 데이터셋 id",
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "left",
    "right",
    "method",
    "built_at",
    "rows",
    "match_rate",
    "unmatched_policy",
    "file"
  ],
  "title": "Mapping",
  "type": "object",
  "$id": "https://pds.local/schemas/mapping.schema.json"
}
