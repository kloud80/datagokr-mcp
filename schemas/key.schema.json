{
  "$defs": {
    "RelatedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "relation": {
          "enum": [
            "parent",
            "child",
            "prefix",
            "same_as",
            "maps_to",
            "composed_of"
          ],
          "title": "Relation",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "relation"
      ],
      "title": "RelatedKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "type": {
      "default": "natural",
      "enum": [
        "primary",
        "foreign",
        "natural",
        "unique"
      ],
      "title": "Type",
      "type": "string"
    },
    "scope": {
      "default": "global",
      "enum": [
        "global",
        "family"
      ],
      "title": "Scope",
      "type": "string"
    },
    "format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "사람용 형식 설명",
      "title": "Format"
    },
    "pattern": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "값 검증 정규식 (있으면)",
      "title": "Pattern"
    },
    "master_datasets": {
      "description": "원장 데이터셋 id",
      "items": {
        "type": "string"
      },
      "title": "Master Datasets",
      "type": "array"
    },
    "composed_of": {
      "items": {
        "type": "string"
      },
      "title": "Composed Of",
      "type": "array"
    },
    "issuer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "코드 부여 주체",
      "title": "Issuer"
    },
    "related_keys": {
      "items": {
        "$ref": "#/$defs/RelatedKey"
      },
      "title": "Related Keys",
      "type": "array"
    },
    "shape_names": {
      "description": "pds/rank/shape.py 연계 키 판정 이름",
      "items": {
        "type": "string"
      },
      "title": "Shape Names",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Key",
  "type": "object",
  "$id": "https://pds.local/schemas/key.schema.json"
}
