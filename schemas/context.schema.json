{
  "$defs": {
    "ContextMember": {
      "additionalProperties": false,
      "description": "세부 부문 단위(sector+subsector, Phase 1 방식) 또는 데이터셋 단위(dataset, Phase 3~).",
      "properties": {
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "subsector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subsector"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "title": "ContextMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "dimension": {
      "enum": [
        "life_context",
        "spatial_regulation",
        "admin_area",
        "shared_key",
        "shared_source",
        "same_concept",
        "economic"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "shared_key 차원의 Key id",
      "title": "Key"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/ContextMember"
      },
      "minItems": 2,
      "title": "Members",
      "type": "array"
    },
    "requires_mappings": {
      "items": {
        "type": "string"
      },
      "title": "Requires Mappings",
      "type": "array"
    },
    "recipe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipe"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    }
  },
  "required": [
    "id",
    "name",
    "dimension",
    "members"
  ],
  "title": "Context",
  "type": "object",
  "$id": "https://pds.local/schemas/context.schema.json"
}
