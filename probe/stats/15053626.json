    "<person id=\"im_101_00001\">\n    <basics>\n        <nameList>\n            <name lang=\"kor\">가정로</name>\n            <name lang=\"chi\">賈廷魯</name>\n        </nameList>\n        <nationList>\n            <nation>한국인</nation>\n        </nationList>\n        <originList>\n            <origin no=\"1\">\n                <place>蘇城 賈氏</place>\n                <source>민국인사, 1</source>\n            </origin>\n        </originList>\n        <birthdayList>\n            <birthday no=\"1\">\n                <date>1904-01-05</date>\n                <source>건국십년, 955</source>\n            </birthday>\n            <birthday no=\"2\">\n                <date>1904-01-05</date>\n                <source>대한연감 4288, 655</source>\n            </birthday>\n        </birthdayList>\n        <ageList>\n            <age no=\"1\">\n                <years>46세(1949년 현재)</years>\n                <source>민국인사, 1</source>\n            </age>\n        </ageList>\n        <birthplaceList>\n            <birthplace no=\"1\">\n                <place>忠淸南道 瑞山 出身</place>\n                <source>민국인사, 1</source>\n            </birthplace>\n            <birthplace no=\"2\">\n                <place>忠淸南道 瑞山郡(본적)</place>\n                <source>건국십년, 955</source>\n            </birthplace>\n            <birthplace no=\"3\">\n                <place>충청남도</place>\n                <source>대한연감 4288, 655</source>\n            </birthplace>\n        </birthplaceList>\n        <addList>\n            <address no=\"1\">\n                <place>忠淸南道 瑞山郡 瑞山邑內里</place>\n                <source>민국인사, 1</source>\n            </address>\n            <address no=\"2\">\n                <place>忠淸南道 大田市 大興洞 532</place>\n                <source>건국십년, 955</source>\n            </address>\n            <address no=\"3\">\n                <place>충청남도 대전시 대흥동 2구 532</place>\n                <source>대한연감 4288, 655</source>\n            </address>\n        </addList>\n    </basics>\n    <family>\n        <spouseList>\n            <spouse no=\"1\">\n                <p>부인</p>\n                <source>건국십년, 955</source>\n            </spouse>\n        </spouseList>\n        <childrenList>\n            <children no=\"1\">\n                <p>5남 4녀</p>\n                <source>건국십년, 955</source>\n            </children>\n        </childrenList>\n    </family>\n    <history>\n        <jobList>\n            <job no=\"1\">\n                <p>관리</p>\n                <source>민국인사, 1</source>\n            </job>\n            <job no=\"2\">\n                <p>대학 사무국장</p>\n                <source>대한연감 4288, 655</source>\n            </job>\n        </jobList>\n        <schoolingList>\n            <school no=\"1\">\n                <p>중학교 졸업</p>\n                <source>건국십년, 955</source>\n            </school>\n            <school no=\"2\">\n                <p>중학교 졸업</p>\n                <source>대한연감 4288, 655</source>\n            </school>\n        </schoolingList>\n        <careerList>\n            <career no=\"1\">\n                <p>道郡行政에 25年間 勤務<br/> 1947年 瑞山郡守 就任</p>\n                <source>민국인사, 1</source>\n            </career>\n            <career no=\"2\">\n                <p>1925년 忠南道屬 25년 大德郡 내무과장<br/>\n1945년 충청남도 재무부 회계과장<br/>\n禮山郡守, 瑞山郡守, 公州郡守 역임<br/>\n1950년 국회 서무과장, <index type=\"학교\">충남대학교</index> 사무국장</p>\n                <source>건국십년, 955</source>\n            </career>\n            <career no=\"3\">\n                <p>충청남도 예산군수, 충청남도 서산군수, 충청남도 공주군수 역임<br/> 1954년 11월 30일 현재 <index type=\"학교\">충남대학</index> 사무국장으로 재직 중</p>\n                <source>대한연감 4288, 655</source>\n            </career>\n        </careerList>\n        <interestList>\n            <interest no=\"1\">\n                <p>독서</p>\n                <source>건국십년, 955</source>\n            </interest>\n        </interestList>\n    </history>\n    <bibliography>\n        <reference id=\"008\">대한민국인사록</reference>\n        <reference id=\"024\">대한민국건국십년지</reference>\n        <reference id=\"027\">대한연감 4288년판</reference>\n    </bibliography>\n</person>\n": 1,
    "<person id=\"im_101_00006\"><basics><nameList><name lang=\"kor\">강건삼</name><name lang=\"chi\">康鍵三</name></nameList><nationList><nation>한국인</nation></nationList><originList><origin no=\"1\"><place>信川</place><source>관원이력 16책, 418</source></origin></originList><birthdayList><birthday no=\"1\"><date>1878-07-20</date><source>관원이력 16책, 418</source></birthday></birthdayList><addList><address no=\"1\"><place>平安北道 嘉山郡 東面 德峯里 第三十一統 八戶</place><source>관원이력 16책, 418</source></address></addList></basics><history><schoolingList><school no=\"1\"><p>1886년 2월 15일 入學本齋<br/> 1886년 10월 8일 七書卒業</p><source>관원이력 16책, 418</source></school></schoolingList><careerList><career no=\"1\"><p>1900년 5월 3일  士<br/> 1903년 6월 21일 任管理署主事 敍判任官八等<br/>1903년 8월 5일 依願免本官</p><source>관원이력 16책, 418</source></career></careerList></history><bibliography><reference id=\"001\">대한제국관원이력서</reference></bibliography></person>": 1,
    "<person id=\"im_101_00007\"><basics><nameList><name lang=\"kor\">강건하</name><name lang=\"chi\">姜乾夏</name></nameList><nationList><nation>한국인</nation></nationList><originList><origin no=\"1\"><place>晉州 姜氏</place><source>민국인사, 5</source></origin></originList><ageList><age no=\"1\"><years>44세(1949년 현재)</years><source>민국인사, 5</source></age></ageList><birthplaceList><birthplace no=\"1\"><place>咸鏡南道 利源 出身</place><source>민국인사, 5</source></birthplace></birthplaceList><addList><address no=\"1\"><place>서울市 益善洞</place><source>민국인사, 5</source></address></addList></basics><history><schoolingList><school no=\"1\"><p>1934年 <index type=\"학교\">京城大學</index>(現 <index type=\"학교\">서울醫科大學</index>) 醫學部 卒業<br/> 1942年 醫學博士 學位 授得</p><source>민국인사, 5</source></school></schoolingList><careerList><career no=\"1\"><p>1943年 서울市 益善洞에서 內科醫院 開業 經營中 한편 慶雲洞會長, <index type=\"단체\">大同靑年團</index> 鐘路區 區團長 等 歷任</p><source>민국인사, 5</source></career></careerList></history><bibliography><reference id=\"008\">대한민국인사록</reference></bibliography></person>": 1,
    "<person id=\"im_101_00008\"><basics><nameList><name lang=\"kor\">강경선</name><name lang=\"chi\">姜璟善</name></nameList><nationList><nation>한국인</nation></nationList><originList><origin no=\"1\"><place>晉州</place><source>신사대동, 815</source></origin></originList><birthdayList><birthday no=\"1\"><date>1846-06-14</date><source>신사대동, 815</source></birthday></birthdayList><addList><address no=\"1\"><place>全羅北道 群山府 長面 大山三里 一統四戶</place><source>신사대동, 815</source></address></addList></basics><family><fatherList><father no=\"1\"><name>姜道周(孝行)</name><source>신사대동, 815</source></father></fatherList><otherList><other no=\"1\"><p>兵部尙書 諡殷烈 姜民瞻 后, 判官 贈兵判 姜應周 十二世孫</p><source>신사대동, 815</source></other></otherList></family><history><schoolingList><school no=\"1\"><p>漢文受學</p><source>신사대동, 815</source></school></schoolingList><careerList><career no=\"1\"><p>官歷 童蒙敎官 承政院同副承旨<br/>曾經 鄕校都有司</p><source>신사대동, 815</source></career></careerList><religionList><religion no=\"1\"><p>儒敎</p><source>신사대동, 815</source></religion></religionList></history><bibliography><reference id=\"002\">조선신사대동보</reference></bibliography></person>": 1,
    "<person id=\"im_101_00010\"><basics><nameList><name lang=\"kor\">강경의</name><name lang=\"chi\">康璟義</name></nameList><nationList><nation>한국인</nation></nationList><birthdayList><birthday no=\"1\"><date>1890-02-99</date><source>인사흥신, 184쪽</source></birthday></birthdayList><ageList><age no=\"1\"><years>45세(1935년 현재)</years><source>인사흥신, 184쪽</source></age></ageList><birthplaceList><birthplace no=\"1\"><place>京城府 三淸洞 62(원적)</place><source>인사흥신, 184쪽</source></birthplace></birthplaceList><addList><address no=\"1\"><place>江原道 通川郡 通川面 中里</place><source>인사흥신, 184쪽</source></address></addList></basics><family><fatherList><father no=\"1\"><name>康磧喆</name><source>인사흥신, 184쪽</source></father></fatherList><spouseList><spouse no=\"1\"><p>聖儀(1897년 9월생. 취미는 園藝)</p><source>인사흥신, 184쪽</source></spouse></spouseList><childrenList><children no=\"1\"><p>장남 康奉均(京城高商 재학), 차남 康世均(京畿商業 재학), 장녀 康貞枝(京城技藝校 졸업), 차녀 康吉子(京城師範校 졸업. 현재 普通學校 訓導), 3녀 康貞子(京城 淑明高女校 재학)</p><source>인사흥신, 184쪽</source></children></childrenList></family><history><schoolingList><school no=\"1\"><p>1906년 3월 師範學校 高等科를 졸업</p><source>인사흥신, 184쪽</source></school></schoolingList><careerList><career no=\"1\"><p>公州, 南原郵便局 主事를 거쳐 臨坡普通學校 訓導가 되었다. 1909년 12월 보통시험에 합격하고 이듬해 2월 郡主事에 임용되어 全羅北道 扶安郡, 全州郡에서 근무했다. 1917년 9월 朝鮮總督府道屬 全羅北道 知事官房 겸임 道警部 警務課 근무, 1924년 全州警察署 근무, 1928년 9월 道警視로 승진하여 江原道 衛生課長이 되었는데, 1930년 7월 總督府 郡守로 전임하여 江原道 橫城郡을 거쳐 通川郡 근무가 되어 1935년에 이른다.</p><source>인사흥신, 184쪽</source></career></careerList><religionList><religion no=\"1\"><p>기독교</p><source>인사흥신, 184쪽</source></religion></religionList><interestList><interest no=\"1\"><p>음악</p><source>인사흥신, 184쪽</source></interest></interestList></history><bibliography><reference id=\"004\">조선인사흥신록</reference></bibliography></person>": 1,
    "<person id=\"im_101_00011\"><basics><nameList><name lang=\"kor\">강경화</name><name lang=\"chi\">姜敬化</name></nameList><nationList><nation>한국인</nation></nationList><birthdayList><birthday no=\"1\"><date>1896-03-03</date><source>왜정인물 6권</source></birthday></birthdayList><birthplaceList><birthplace no=\"1\"><place>忠淸南道 論山郡 夫赤面 新橋里 512(원적)</place><source>왜정인물 6권</source></birthplace></birthplaceList><addList><address no=\"1\"><place>江原道 江陵郡 江陵面 旭町 258</place><source>왜정인물 6권</source></address></addList></basics><history><jobList><job no=\"1\"><p>과자상 겸 담배소매상</p><source>왜정인물 6권</source></job></jobList><schoolingList><school no=\"1\"><p>15세까지 耶蘇附屬學校에서 普通學을 배운 후 京城 <index type=\"학교\">敬信中學</index>에 입학하여 2년간 수업</p><source>왜정인물 6권</source></school></schoolingList><careerList><career no=\"1\"><p>1919년 咸興地方法院에서 소요죄로 笞60에 처해짐<br/> 1920년 3월 保安法 위반으로 京城地方法院에서 징역 6개월에 처해짐<br/> 출옥 후 1924년까지 소재를 알 수 없음<br/> 그 후 肩書地에서 과자상과 담배소매상을 운영함.</p><source>왜정인물 6권</source></career></careerList><estimationList><estimation no=\"1\"><p>신장 5尺 3寸<br/> 얼굴이 길고 피부색이 검음. 오른쪽 발등 관절부분부터 잘림<br/> 배일사상을 가지고 불온의 언동을 할 우려가 있음</p><source>왜정인물 6권</source></estimation></estimationList><friendList><friend no=\"1\"><name>崔三悅, 申詩哲(全川 거주), 金好俊, 李翊宋(京城 거주), 李東草(北靑郡 良宗面 거주)</name><source>왜정인물 6권</source></friend></friendList></history><bibliography><reference id=\"005\">왜정시대인물사료</reference></bibliography></person>": 1
