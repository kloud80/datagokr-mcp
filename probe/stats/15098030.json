01DC7EA7E9DA05500000001A\",\n\"si\": \"01DC7EA7E9DA05500000001C\",\n\"bf\": 0,\n\"ru\": [\n{\n\"cp\": \"01DC7EA7E9DA055000000017\",\n\"ch\": [\n{\n\"t\": \"이번 축제는 ‘고래와 함께한 30년’, 고래 보호와 해양 생태의 중요성, 인간과 자연의 공존 가치를 다양한 방식으로 담아냅니다. 장생포의 바다, 도시 공간을 무대로 한 대규모 퍼레이드와 공연, 미디어아트와 전시 콘텐츠는 방문객들에게 깊은 감동과 색다른 경험을 선사할 것입니다.\"\n}\n]\n}\n]\n},\n\"01DC7EA7E9DA055000000013\": {\n\"np\": \"01DC7EA7E9DA055000000014\",\n\"id\": -2147483648,\n\"pp\": \"01DC7EA7E9DA05500000001A\",\n\"si\": \"01DC7EA7E9DA05500000001C\",\n\"bf\": 0,\n\"ru\": [\n{\n\"cp\": \"01DC7EA7E9DA055000000017\",\n\"ch\": [\n{\n\"t\": \"또한 가족 단위 방문객부터 청소년, 관광객까지 모두가 함께 즐길 수 있도록 고래 생태 체험, 교육 프로그램, 참여형 이벤트, 어린이 프로그램 등 세대별·계층별 맞춤 콘텐츠가 풍성하게 마련됩니다. 여기에 울산의 특색 있는 음식과 지역 예술인들이 참여하는 문화·예술 프로그램이 어우러져 축제의 즐거움을 더합니다.\"\n}\n]\n}\n]\n},\n\"01DC7EA7E9DA055000000014\": {\n\"np\": \"\",\n\"id\": -2147483648,\n\"pp\": \"01DC7EA7E9DA05500000001A\",\n\"si\": \"01DC7EA7E9DA05500000001C\",\n\"bf\": 0,\n\"ru\": [\n{\n\"cp\": \"01DC7EA7E9DA055000000017\",\n\"ch\": [\n{\n\"t\": \"제30회 울산고래축제는 단순한 지역 행사를 넘어, 울산이 지향하는 지속 가능한 해양 도시의 비전을 국내외에 알리는 소중한 기회가 될 것입니다. 고래의 숨결과 바다의 이야기가 살아 있는 도시 울산에서, 시민과 관광객이 함께 만들어가는 특별한 축제의 순간을 경험해 보시기 바랍니다.\"\n}\n]\n}\n]\n}\n},\n\"sl\": { },\n\"cs\": {\n\"01DC7EA7E9DA05500000000F\": {\n\"cc\": 2,\n\"ci\": 1936024420,\n\"td\": 0,\n\"tv\": false,\n\"sc\": 1134,\n\"ts\": 8000,\n\"ms\": \"01DC7EA7E9DA05500000001D\",\n\"os\": \"01DC7EA7E9DA055000000019\",\n\"gl\": 0,\n\"gc\": 0,\n\"gw\": false,\n\"ns\": 0,\n\"np\": 0,\n\"ni\": 0,\n\"nt\": 0,\n\"ne\": 0,\n\"hh\": false,\n\"hf\": false,\n\"hm\": false,\n\"fb\": false,\n\"hb\": false,\n\"fi\": false,\n\"hi\": false,\n\"hp\": false,\n\"he\": false,\n\"sl\": false,\n\"lr\": 0,\n\"lc\": 0,\n\"ld\": 0,\n\"ls\": 0,\n\"pp\": {\n\"ls\": false,\n\"wi\": 59528,\n\"he\": 84188,\n\"gt\": 0,\n\"ml\": 5669,\n\"mr\": 5669,\n\"mt\": 2834,\n\"mb\": 1417,\n\"mh\": 4251,\n\"mf\": 4251,\n\"mg\": 0\n},\n\"fn\": {\n\"at\": 0,\n\"au\": \"\",\n\"ap\": \"\",\n\"ac\": \")\",\n\"as\": false,\n\"ll\": 