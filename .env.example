# datagokr-mcp 환경변수 — 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다.
# 값이 없는 항목은 그 기능만 꺼진다 (예: 법제처 키가 없으면 법령 원문 수집만 안 됨).

# ── LLM (채팅·전략 설명·설명문 초안). 둘 중 하나
CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# 채팅 모델 (기본 claude-sonnet-5-5). 품질을 더 원하면 claude-opus-5-5 — claude-haiku-4-5는 인용·제외 판단이 약해 권하지 않는다
PDS_CHAT_MODEL=

# ── 공공데이터포털 (data.go.kr) — 마이페이지의 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# 활용신청 자동화(Playwright)용 계정 — 로그인은 사람이 보안문자를 풀어야 한다 (python -m pds.probe.portal)
DATA_GO_KR_ID=
DATA_GO_KR_PW=

# ── 외부 사이트 키 — 생성: python -m pds.expand.external_keys (Docs 사이트 커버리지와 같은 상태)
# 상태: 확보=키로 검증 중 · 대기=신청·승인 기다림 · 필요=아직 키 없음. 숫자는 그 사이트에 링크된 포털 데이터 수(검증 수)
# 비어 있는 변수를 채우면 그 사이트 검증을 돌릴 수 있다. 사이트별 발급 방법은 추가외부키.md, 발급 방법이 '확인 필요'인 곳은 아직 사이트를 살펴보지 않은 곳
DATA_SEOUL_API_KEY=                             # [확보] 서울 열린데이터광장 · 서울 열린데이터광장 (OpenAPI 서버) — 5,934건 (검증 5,479)
DATA_MAFRA_API_KEY=                             # [확보] 농림축산식품 공공데이터 포털 — 483건 (검증 289)
