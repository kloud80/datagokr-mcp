# datagokr-mcp 환경변수 — 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다.
# 값이 없는 항목은 그 기능만 꺼진다 (예: 법제처 키가 없으면 법령 원문 수집만 안 됨).

# ── LLM (채팅·전략 설명·설명문 초안). 둘 중 하나
CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# 채팅 모델 (기본 claude-sonnet-5-5). 품질을 더 원하면 claude-opus-5-5 — claude-haiku-4-5는 인용·제외 판단이 약해 권하지 않는다
PDS_CHAT_MODEL=

# ── 공공데이터포털 (data.go.kr) — 마이페이지의 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# 활용신청 자동화(Playwright)용 계정 — 로그인은 사람이 보안문자를 풀어야 한다 (python -m pds.probe.portal)
DATA_GO_KR_ID=
DATA_GO_KR_PW=

# ── 외부 사이트 키 (knowledge/key_issuers.yaml 참고)
VWORLD_API_KEY=            # 브이월드 (연속지적도·공시지가·토지특성·지오코더)
VWORLD_DOMAIN=             # 브이월드 키에 등록한 서비스 URL (개발키면 필요)
OPEN_NEIS_API_KEY=         # 나이스 교육정보 개방 포털
DATA_SEOUL_API_KEY=        # 서울 열린데이터광장
OPEN_LAW_GO_KR_API_KEY=    # 법제처 국가법령정보 공동활용 (OC 값)
# 키 미보유 상위 사이트 (2026-10-14 가입 목록 — 데이터 수 순)
REB_API_KEY=               # 한국부동산원 R-ONE 부동산통계
KOSIS_API_KEY=             # 통계청 KOSIS 공유서비스 (통계표 목록·자료)
KIPRIS_API_KEY=            # KIPRIS Plus 특허정보
MND_API_KEY=               # 국방부 국방 공공데이터
SGIS_CONSUMER_KEY=         # 통계청 SGIS 통계지리정보 (서비스 ID)
SGIS_CONSUMER_SECRET=      # SGIS 보안 Key
CALS_API_KEY=              # 국토부 건설사업정보(CALS)
NFQS_API_KEY=              # 국립농산물품질관리원
OPENFISCAL_API_KEY=        # 기재부 열린재정 (나라 살림 세입·세출)
NEINS_API_KEY=             # 국립환경과학원 (ecvam.neins.go.kr)
ECOBANK_API_KEY=           # 국립생태원 에코뱅크
NGII_API_KEY=              # 국토지리정보원 국토정보플랫폼
KEPCO_API_KEY=             # 한전 전력데이터 개방포털
CHILDCARE_API_KEY=         # 어린이집정보공개포털
OPINET_API_KEY=            # 오피넷 유가
KHOA_API_KEY=              # 국립해양조사원 바다누리
ECOS_API_KEY=              # 한국은행 ECOS 경제통계
KRIC_API_KEY=              # 철도산업정보센터
GARAK_API_KEY=             # 서울시농수산식품공사 가락시장
SAFEMAP_API_KEY=           # 생활안전지도 (승인 대기)
KMA_APIHUB_API_KEY=        # 기상청 API허브 (API마다 활용신청)
NONGSARO_API_KEY=          # 농사로 (승인 대기)

# ── Postgres (선택 — 지식 적재·카탈로그 DB. 없으면 파일만으로 서비스가 돈다)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SCHEME=pds        # 적재할 스키마 (테이블 접두어 pds_)

# ── 공개 서버 (리버스 프록시 뒤) — https://labs.ai.bigvalue.co.kr → 이 PC 9050
PDS_PUBLIC_URL=            # 안내문(robots.txt·llms.txt)에 쓸 공개 주소 (예: https://labs.ai.bigvalue.co.kr)
PDS_TRUSTED_PROXIES=       # 이 IP에서 온 연결만 X-Forwarded-For를 믿는다 (쉼표 구분, 예: 3.37.241.176)
