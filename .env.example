# ── Postgres (선택 — 지식 적재·카탈로그 DB. 없으면 파일만으로 서비스가 돈다)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SCHEME=pds        # 적재할 스키마 (테이블 접두어 pds_)

# ── 공개 서버 (리버스 프록시 뒤) — https://labs.ai.bigvalue.co.kr → 이 PC 9050
PDS_PUBLIC_URL=            # 안내문(robots.txt·llms.txt)에 쓸 공개 주소 (예: https://labs.ai.bigvalue.co.kr)
PDS_TRUSTED_PROXIES=       # 이 IP에서 온 연결만 X-Forwarded-For를 믿는다 (쉼표 구분, 예: 3.37.241.176)
