# datagokr-mcp 환경변수 — 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다.
# 값이 없는 항목은 그 기능만 꺼진다 (예: 법제처 키가 없으면 법령 원문 수집만 안 됨).

# ── LLM (채팅·전략 설명·설명문 초안). 둘 중 하나
CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# 채팅 모델 (기본 claude-opus-5-5). 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-4-5
PDS_CHAT_MODEL=

# ── 공공데이터포털 (data.go.kr) — 마이페이지의 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# 활용신청 자동화(Playwright)용 계정 — 로그인은 사람이 보안문자를 풀어야 한다 (python -m pds.probe.portal)
DATA_GO_KR_ID=
DATA_GO_KR_PW=

# ── 외부 사이트 키 (knowledge/key_issuers.yaml 참고)
VWORLD_API_KEY=            # 브이월드 (연속지적도·공시지가·토지특성·지오코더)
VWORLD_DOMAIN=             # 브이월드 키에 등록한 서비스 URL (개발키면 필요)
OPEN_NEIS_API_KEY=         # 나이스 교육정보 개방 포털
DATA_SEOUL_API_KEY=        # 서울 열린데이터광장
OPEN_LAW_GO_KR_API_KEY=    # 법제처 국가법령정보 공동활용 (OC 값)

# ── Postgres (선택 — 지식 적재·카탈로그 DB. 없으면 파일만으로 서비스가 돈다)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SCHEME=pds        # 적재할 스키마 (테이블 접두어 pds_)
